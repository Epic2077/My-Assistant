# Local dashboard binds only to localhost.
HOST=127.0.0.1
PORT=4173
OWNER_NAME=Ashkan

# AI provider uses an OpenAI-compatible Chat Completions API.
# DeepSeek example: https://api.deepseek.com/v1 + deepseek-chat
# Ollama example: http://127.0.0.1:11434/v1 + a model you have pulled
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=20000

# Safety: true means decisions are logged but messages are NOT sent.
# Turn live sending on only after testing in the local dashboard.
DRY_RUN=true

# Telegram Bot API. Regular messages to the bot are supported; personal-inbox access requires Telegram Business updates.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# Optional private Telegram chat used for owner reports and commands.
# DM your bot with /start first; the console will show the chat ID to put here.
TELEGRAM_OWNER_CHAT_ID=

# Optional personal-account Telegram client (MTProto; requires your own API ID/hash + one-time login).
# Get API credentials from https://my.telegram.org/apps. Keep the session file private.
TELEGRAM_USER_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION_PATH=data/telegram-user.session
# Explicit opt-in gate for sending fixed AI-consent notices. This may send consent/control notices
# while DRY_RUN=true; it never enables AI replies. AI replies still obey DRY_RUN and Busy Mode.
TELEGRAM_USER_CONSENT_MESSAGES_ENABLED=false

# Optional unofficial WhatsApp Web connector. Do not use with a number
# you cannot afford to have restricted. Install separately; see README.
WHATSAPP_ENABLED=false
